generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Benutzer & Rollen
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  INVITED // vom Admin angelegt, hat sich noch nie eingeloggt
  ACTIVE
  BLOCKED
}

// Die User-Tabelle ist gleichzeitig die Allowlist: Wer hier nicht steht,
// kommt trotz gültigem Google-/GitHub-Konto nicht rein (siehe lib/auth.ts).
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  emailVerified DateTime?
  role          Role       @default(VIEWER)
  status        UserStatus @default(INVITED)
  createdAt     DateTime   @default(now())
  lastLoginAt   DateTime?
  // KI-Zugang (MCP): nur ausdrücklich von einem Admin vergeben — auch die
  // Rolle ADMIN schließt ihn nicht ein (lib/services/ai-access.ts).
  aiAccess      AiAccess   @default(NONE)
  // Bezugsperson „das bin ich“ (docs/fachlich/bezugsperson.md). Verschwindet die
  // Person, bleibt der Benutzer ohne Zuordnung; beim Zusammenführen wandert
  // der Verweis auf die bleibende Person (lib/services/merge.ts).
  personId      String?
  person        Person?    @relation("UserSelf", fields: [personId], references: [id], onDelete: SetNull)
  // Neuigkeiten: Kennung des zuletzt gesehenen Release aus CHANGELOG.md
  // („JJJJ-MM-TT.N“, lib/release-notes.ts). Leer = noch keins gesehen; dann
  // zeigt „Was ist neu?“ nur das neueste.
  lastSeenReleaseId String?

  accounts Account[]
  sessions Session[]

  uploadedMedia  MediaAsset[]         @relation("MediaUploader")
  auditLogs      AuditLog[]
  changeSets     ChangeSet[]
  families       UserFamily[]
  createdSources Source[]             @relation("SourceCreator")
  apiTokens      ApiToken[]
  importBatches  ImportBatch[]        @relation("ImportUser")
  dismissals     DuplicateDismissal[]
  dupReviews     DuplicateReview[]

  @@index([personId])
}

// ---------------------------------------------------------------------------
// KI-Zugang (MCP)
// ---------------------------------------------------------------------------

// Geordnete Stufe statt zweier Schalter: „schreiben ohne lesen" ist so gar
// nicht darstellbar. WRITE schließt READ ein.
enum AiAccess {
  NONE
  READ
  WRITE
}

enum ApiTokenLevel {
  READ
  WRITE
}

// Herkunft eines Zugangsschlüssels: PERSONAL = vom Benutzer in der App
// erzeugt; OAUTH = später über einen OAuth-Ablauf (z.B. claude.ai) ausgestellt.
enum ApiTokenKind {
  PERSONAL
  OAUTH
}

// Persönlicher, widerrufbarer Zugangsschlüssel für den MCP-Endpunkt.
// Gespeichert wird nie das Geheimnis, nur sein SHA-256-Hash (lib/ai-tokens.ts).
// Die wirksame Stufe ist min(level, User.aiAccess) und wird bei jeder Prüfung
// neu berechnet — ein Herabsetzen der Benutzerrechte wirkt also sofort, ohne
// die Schlüssel umzuschreiben.
model ApiToken {
  id         String        @id @default(cuid())
  userId     String
  name       String
  // Nicht geheimer Anfang des Schlüssels ("ftk_" + 12 Hex-Zeichen): zum
  // Wiedererkennen in Listen und zum Nachschlagen bei der Prüfung.
  prefix     String        @unique
  secretHash String
  level      ApiTokenLevel
  kind       ApiTokenKind  @default(PERSONAL)
  createdAt  DateTime      @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Familien — Einheit der Rechtevergabe
// ---------------------------------------------------------------------------

model Family {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  persons PersonFamily[]
  members UserFamily[]
}

// Eine Person gehört zu beliebig vielen Familien. Durch Heirat verbinden sich
// Familien — wer einheiratet, gehört fortan zu beiden.
model PersonFamily {
  personId String
  familyId String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([personId, familyId])
  @@index([familyId])
}

enum FamilyRole {
  EDITOR
  VIEWER
}

// Zugriff eines Benutzers auf eine Familie. Ohne Eintrag: kein Zugriff.
model UserFamily {
  userId   String
  familyId String
  role     FamilyRole @default(VIEWER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, familyId])
  @@index([familyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Stammbaum
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// Ungenaue Daten: Das DateTime-Feld bleibt der sortierbare Ankerpunkt
// (Jahres- bzw. Monatsanfang bei geringerer Genauigkeit), Genauigkeit und
// Zusatz beschreiben, wie es gemeint ist. Die Standardwerte (Tag, genau)
// entsprechen allen Daten, die vor dieser Erweiterung erfasst wurden.
// Siehe lib/dates.ts.
enum DatePrecision {
  DAY
  MONTH
  YEAR
}

// Bereiche (BETWEEN, PERIOD) haben zusätzlich ein Ende in den Spalten
// `…To`/`…ToPrecision`; der Anker ist dann der Anfang. Der Wortlaut einer
// Angabe, die sich nicht (oder nicht verlustfrei) strukturiert darstellen
// lässt — „Weihnachten 1850“, julianischer Kalender, GEDCOM-Datumsphrase —,
// steht unverändert in `…Phrase`. Siehe lib/dates.ts.
enum DateQualifier {
  EXACT
  ABOUT // um, ca. (GEDCOM ABT)
  BEFORE // vor (BEF)
  AFTER // nach (AFT)
  ESTIMATED // geschätzt (EST)
  CALCULATED // errechnet, z.B. aus einer Altersangabe (CAL)
  BETWEEN // zwischen Anfang und Ende, ein Zeitpunkt darin (BET … AND …)
  PERIOD // Zeitraum von … bis …; ohne Ende: ab/seit (FROM … [TO …])
  UNTIL // Zeitraum bis … (TO …)
}

model Person {
  id                   String        @id @default(cuid())
  givenName            String
  familyName           String?
  birthName            String?
  // Teile des Hauptnamens (GEDCOM NICK, NPFX, NSFX). Weitere Namen: PersonName.
  nickname             String?
  namePrefix           String? // Titel/Vorsatz: „Dr.“, „Graf“
  nameSuffix           String? // Zusatz: „jun.“, „III.“
  gender               Gender        @default(UNKNOWN)
  birthDate            DateTime?
  birthDatePrecision   DatePrecision @default(DAY)
  birthDateQualifier   DateQualifier @default(EXACT)
  birthDateTo          DateTime?
  birthDateToPrecision DatePrecision @default(DAY)
  birthDatePhrase      String?
  birthPlace           String?
  deathDate            DateTime?
  deathDatePrecision   DatePrecision @default(DAY)
  deathDateQualifier   DateQualifier @default(EXACT)
  deathDateTo          DateTime?
  deathDateToPrecision DatePrecision @default(DAY)
  deathDatePhrase      String?
  deathPlace           String?
  deathCause           String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Beziehungen, in denen diese Person die Quelle bzw. das Ziel ist.
  relationsFrom Relationship[] @relation("RelationFrom")
  relationsTo   Relationship[] @relation("RelationTo")

  media        PersonMedia[]
  families     PersonFamily[]
  citations    Citation[]
  events       Event[]
  names        PersonName[]
  externalIds  ExternalId[]
  rawRecords   ImportRawRecord[]
  // Herkunft: je Datensatz der Quelle ein Link — nach dem Zusammenführen
  // zweier importierter Personen mehrere (docs/fachlich/dubletten.md).
  importLinks  ImportLink[]
  // Als „kein Duplikat“ markierte Paare (lib/services/duplicates.ts).
  dismissedAsA DuplicateDismissal[] @relation("DismissalA")
  dismissedAsB DuplicateDismissal[] @relation("DismissalB")
  reviewsAsA   DuplicateReview[]    @relation("ReviewA")
  reviewsAsB   DuplicateReview[]    @relation("ReviewB")
  // Benutzer, die diese Person als „das bin ich“ gewählt haben.
  selfOfUsers  User[]               @relation("UserSelf")
  // Alte Kennungen, die nach einem Zusammenführen auf diese Person zeigen.
  redirectsTo  PersonRedirect[]

  @@index([familyName, givenName])
}

// Alte Kennung einer aufgegangenen Person → bleibende Person
// (docs/fachlich/dubletten.md; lib/services/redirects.ts). `fromId` verweist
// bewusst auf nichts: die Person gibt es nicht mehr. Wird die bleibende Person
// gelöscht, verschwinden ihre alten Kennungen mit (Cascade). Ketten gibt es
// nicht: Geht die bleibende Person später selbst auf, biegt das Zusammenführen
// alle Einträge auf die neue bleibende Person um.
model PersonRedirect {
  fromId    String   @id
  toId      String
  createdAt DateTime @default(now())

  to Person @relation(fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId])
}

// Weitere Namen einer Person — der Hauptname bleibt in Person
// (givenName/familyName/birthName + nickname/namePrefix/nameSuffix).
enum PersonNameType {
  BIRTH // abweichend erfasster Geburtsname
  MARRIED // (früherer) Ehename (MyHeritage _MARNM bei mehreren Ehen)
  ALIAS // auch bekannt als (GEDCOM aka)
  RELIGIOUS // Ordens-/Taufname
  IMMIGRANT // Name nach Einwanderung
  VARIANT // andere Schreibweise
  OTHER
}

model PersonName {
  id         String         @id @default(cuid())
  personId   String
  type       PersonNameType @default(OTHER)
  givenName  String?
  familyName String?
  prefix     String?
  suffix     String?
  nickname   String?
  // Freie Bezeichnung, z.B. GEDCOM NAME.TYPE bei OTHER.
  label      String?
  notes      String?
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  importLinks ImportLink[]

  @@index([personId])
}

enum RelationType {
  PARENT_OF // from = Elternteil, to = Kind
  PARTNER_OF // ungerichtet, wird kanonisch gespeichert (fromId < toId)
}

enum RelationSubtype {
  BIOLOGICAL
  ADOPTIVE
  STEP
  FOSTER
  MARRIED
  UNMARRIED
  DIVORCED
  PARTNER_UNKNOWN // Partnerschaft, Ehestand unbekannt (z.B. Import ohne Heiratsangabe)
}

// Beziehungen liegen bewusst in einer eigenen Tabelle statt als parentId auf
// Person: nur so sind Adoption, Stiefverhältnisse, Mehrfachehen und
// Beziehungszeiträume abbildbar, ohne das Schema zu ändern.
model Relationship {
  id                   String          @id @default(cuid())
  type                 RelationType
  subtype              RelationSubtype @default(BIOLOGICAL)
  fromPersonId         String
  toPersonId           String
  startDate            DateTime?
  startDatePrecision   DatePrecision   @default(DAY)
  startDateQualifier   DateQualifier   @default(EXACT)
  startDateTo          DateTime?
  startDateToPrecision DatePrecision   @default(DAY)
  startDatePhrase      String?
  // Ort der Heirat bzw. des Beginns (PARTNER_OF).
  startPlace           String?
  endDate              DateTime?
  endDatePrecision     DatePrecision   @default(DAY)
  endDateQualifier     DateQualifier   @default(EXACT)
  endDateTo            DateTime?
  endDateToPrecision   DatePrecision   @default(DAY)
  endDatePhrase        String?
  // Ort der Scheidung bzw. des Endes.
  endPlace             String?
  notes                String?
  createdAt            DateTime        @default(now())

  fromPerson  Person              @relation("RelationFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson    Person              @relation("RelationTo", fields: [toPersonId], references: [id], onDelete: Cascade)
  media       RelationshipMedia[]
  citations   Citation[]
  events      Event[]
  externalIds ExternalId[]
  rawRecords  ImportRawRecord[]
  importLinks ImportLink[]

  @@unique([type, fromPersonId, toPersonId])
  @@index([fromPersonId])
  @@index([toPersonId])
}

// ---------------------------------------------------------------------------
// Lebensereignisse
// ---------------------------------------------------------------------------

// Ereignisarten nach GEDCOM 5.5.1 (Tag in Klammern). Geburt und Tod einer
// Person sowie Heirat und Scheidung einer Partnerschaft stehen weiterhin in
// Person bzw. Relationship — BIRTH, DEATH, MARRIAGE und DIVORCE gibt es hier
// nur als abweichende Zweitangabe (isAlternative). Regeln: lib/events.ts.
enum EventType {
  // Person
  BIRTH // nur Alternative (BIRT)
  DEATH // nur Alternative (DEAT)
  BAPTISM // Taufe (BAPM)
  CHRISTENING // Kindstaufe (CHR)
  ADULT_CHRISTENING // Erwachsenentaufe (CHRA)
  BURIAL // Beerdigung (BURI)
  CREMATION // Einäscherung (CREM)
  ADOPTION // Adoption (ADOP)
  CONFIRMATION // Konfirmation/Firmung (CONF)
  FIRST_COMMUNION // Erstkommunion (FCOM)
  BAR_MITZVAH // (BARM)
  BAS_MITZVAH // (BASM)
  BLESSING // Segnung (BLES)
  ORDINATION // Ordination/Weihe (ORDN)
  GRADUATION // Abschluss (GRAD)
  EDUCATION // Ausbildung (EDUC)
  OCCUPATION // Beruf (OCCU)
  RETIREMENT // Ruhestand (RETI)
  RESIDENCE // Wohnort (RESI)
  CENSUS // Volkszählung (CENS)
  EMIGRATION // Auswanderung (EMIG)
  IMMIGRATION // Einwanderung (IMMI)
  NATURALIZATION // Einbürgerung (NATU)
  MILITARY_SERVICE // Militärdienst (_MILT, EVEN TYPE Military)
  RELIGION // Religion (RELI)
  NATIONALITY // Staatsangehörigkeit (NATI)
  TITLE // Adels-/Ehrentitel (TITL)
  PROPERTY // Besitz (PROP)
  PHYSICAL_DESCRIPTION // Beschreibung (DSCR)
  ID_NUMBER // Kennnummer (IDNO, SSN)
  CASTE // Stand/Kaste (CAST)
  CHILDREN_COUNT // Kinderzahl (NCHI)
  MARRIAGE_COUNT // Zahl der Ehen (NMR)
  WILL // Testament (WILL)
  PROBATE // Testamentseröffnung (PROB)
  // Partnerschaft (PARTNER_OF)
  MARRIAGE // nur Alternative (MARR)
  DIVORCE // nur Alternative (DIV)
  ENGAGEMENT // Verlobung (ENGA)
  MARRIAGE_BANNS // Aufgebot (MARB)
  MARRIAGE_CONTRACT // Ehevertrag (MARC)
  MARRIAGE_LICENSE // Heiratserlaubnis (MARL)
  MARRIAGE_SETTLEMENT // Ehevereinbarung (MARS)
  DIVORCE_FILED // Scheidungsantrag (DIVF)
  ANNULMENT // Annullierung (ANUL)
  // Frei (EVEN/FACT mit TYPE): Bezeichnung in `label`
  CUSTOM
}

// Ein Ereignis gehört zu GENAU EINER Person oder Beziehung (geprüft im
// Dienst). Sichtbarkeit und Bearbeitbarkeit folgen dem Träger.
model Event {
  id              String        @id @default(cuid())
  personId        String?
  relationshipId  String?
  type            EventType
  // Bei CUSTOM Pflicht („Militärdienst“), sonst optionale Präzisierung
  // (GEDCOM TYPE, z.B. „Seebestattung“).
  label           String?
  // Abweichende Zweitangabe zu einer Tatsache, die schon anderswo steht
  // (zweite Geburtsangabe einer Datei) — überschreibt nichts.
  isAlternative   Boolean       @default(false)
  date            DateTime?
  datePrecision   DatePrecision @default(DAY)
  dateQualifier   DateQualifier @default(EXACT)
  dateTo          DateTime?
  dateToPrecision DatePrecision @default(DAY)
  datePhrase      String?
  place           String?
  address         String? // Anschrift (ADDR), Zeilen mit \n
  value           String? // Wert/Beschreibung: der Beruf, die Religion, der Titel …
  cause           String? // Ursache (CAUS)
  age             String? // Altersangabe der Quelle, wörtlich (AGE), z.B. „72y“
  agency          String? // Zuständige Stelle (AGNC): Pfarramt, Arbeitgeber
  notes           String?
  // Reihenfolge undatierter Ereignisse (und Gleichstand bei gleichem Datum).
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  citations    Citation[]
  externalIds  ExternalId[]
  importLinks  ImportLink[]
  media        EventMedia[]

  @@index([personId])
  @@index([relationshipId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Medien
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String   @unique // relativer Dateipfad unterhalb von MEDIA_DIR
  thumbnailKey String?
  // Ursprünglicher Dateiname beim Upload. Dient als menschenlesbarer Verweis
  // im Export — der storageKey ist eine UUID und sagt niemandem etwas.
  fileName     String?
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy    User?               @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  persons       PersonMedia[]
  relationships RelationshipMedia[]
  // Hauptscan einer Quelle (Source.mediaId, älteres Feld) — siehe SourceMedia.
  sources       Source[]
  // Bilder an Quellen, Ereignissen und Belegen (docs/fachlich/bilder-an-eintraegen.md).
  sourceLinks   SourceMedia[]
  eventLinks    EventMedia[]
  citationLinks CitationMedia[]
  externalIds   ExternalId[]
  importLinks   ImportLink[]
}

// Bilder zu einem Ereignis statt zu einer Person — vor allem Hochzeitsfotos.
model RelationshipMedia {
  relationshipId String
  mediaId        String
  isPrimary      Boolean @default(false)
  sortOrder      Int     @default(0)

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  media        MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([relationshipId, mediaId])
  @@index([mediaId])
}

model PersonMedia {
  personId  String
  mediaId   String
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  person Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([personId, mediaId])
  @@index([mediaId])
}

// Bilder an einer Quelle (Scans mehrerer Seiten, Fotos eines Grabsteins …).
// Source.mediaId bleibt der „Hauptscan“; die App liest beide Stellen
// zusammen (lib/services/attached-media.ts), ohne Datenübernahme.
model SourceMedia {
  sourceId  String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  source Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([sourceId, mediaId])
  @@index([mediaId])
}

// Bilder an einem Lebensereignis (Taufschein, Foto der Konfirmation …).
// Sichtbar und änderbar wie das Ereignis.
model EventMedia {
  eventId   String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([eventId, mediaId])
  @@index([mediaId])
}

// Bilder an einem Beleg — der Ausschnitt einer Quelle, der genau diese
// Angabe belegt (der Eintrag im Kirchenbuch). Sichtbar und änderbar wie der Beleg.
model CitationMedia {
  citationId String
  mediaId    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  citation Citation   @relation(fields: [citationId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([citationId, mediaId])
  @@index([mediaId])
}

// ---------------------------------------------------------------------------
// Quellen und Belege
// ---------------------------------------------------------------------------

enum SourceKind {
  CHURCH_BOOK // Kirchenbuch
  CIVIL_REGISTRY // Standesamt
  CENSUS // Volkszählung, Einwohnerlisten
  GRAVESTONE // Grabstein, Friedhofsregister
  FAMILY_DOCUMENT // Familienunterlagen, Briefe, Bibel
  ORAL // mündliche Überlieferung
  WEBSITE // Webseite, Online-Datenbank
  OTHER
  // Seit „Quellen aus dem Import sauber übernehmen“ (lib/source-classify.ts):
  ONLINE_TREE // Stammbäume anderer Nutzer bei einem Anbieter (MyHeritage, Ancestry …) — keine unabhängige Quelle
  ONLINE_COLLECTION // Online-Sammlung/Datenbank eines Anbieters (ohne bestimmbare Inhaltsart)
}

// Eine Quelle (z.B. ein Kirchenbuch) kann viele Angaben vieler Personen
// belegen. Sichtbar ist sie, sobald der Benutzer etwas sieht, wofür sie
// zitiert wird — Rechte hängen also an den Belegen (lib/services/sources.ts).
model Source {
  id              String        @id @default(cuid())
  title           String
  kind            SourceKind    @default(OTHER)
  // Freie Art, wenn die Quelle eine eigene Kategorie mitbringt (z.B. „Adressbuch“).
  kindLabel       String?
  // Anbieter, über den die Quelle zugänglich ist („MyHeritage“, „Ancestry“ …).
  provider        String?
  author          String? // Verfasser bzw. Herkunft
  repository      String? // Archiv, Pfarramt, Standesamt
  callNumber      String? // Signatur
  url             String?
  date            DateTime?
  datePrecision   DatePrecision @default(DAY)
  dateQualifier   DateQualifier @default(EXACT)
  dateTo          DateTime?
  dateToPrecision DatePrecision @default(DAY)
  datePhrase      String?
  notes           String? // Abschrift, Notizen
  // Hauptscan (älteres Feld); weitere Bilder der Quelle in SourceMedia.
  mediaId         String?
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  media       MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("SourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  citations   Citation[]
  externalIds ExternalId[]
  rawRecords  ImportRawRecord[]
  importLinks ImportLink[]
  images      SourceMedia[]

  @@index([title])
}

enum CitationFact {
  NAME
  BIRTH
  DEATH
  PARTNERSHIP // Heirat bzw. Partnerschaft (nur an PARTNER_OF)
  PARENTAGE // Abstammung (nur an PARENT_OF)
  OTHER
  EVENT // ein Ereignis (Citation.eventId gesetzt)
}

enum CitationConfidence {
  HIGH // gesichert
  MEDIUM // wahrscheinlich
  LOW // unsicher
}

// Beleg: eine Quelle stützt eine Angabe zu GENAU EINER Person oder Beziehung
// (geprüft im Dienst — Prisma kennt keine Check-Constraints). Ein Beleg für
// ein Ereignis trägt zusätzlich eventId (fact = EVENT); personId bzw.
// relationshipId ist dann der Träger des Ereignisses — so gelten Rechte,
// Export und Löschen unverändert.
model Citation {
  id             String              @id @default(cuid())
  sourceId       String
  personId       String?
  relationshipId String?
  eventId        String?
  fact           CitationFact        @default(OTHER)
  detail         String? // Seite, Eintragsnummer, Fundstelle (GEDCOM PAGE)
  // Internetadresse des Eintrags (aus PAGE herausgelöst; nur http/https).
  url            String?
  confidence     CitationConfidence?
  text           String? // Abschrift bzw. Notiz zum Beleg (GEDCOM DATA.TEXT, NOTE)
  createdAt      DateTime            @default(now())

  source       Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  importLinks  ImportLink[]
  media        CitationMedia[]

  @@index([sourceId])
  @@index([personId])
  @@index([relationshipId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Import (GEDCOM u.a.): Herkunft, Fremdkennungen, nicht zugeordnete Daten
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING // angelegt, Datei gespeichert
  COMPLETED
  FAILED
}

// Ein Importlauf. Nur für Administratoren (lib/services/imports.ts). Die
// Originaldatei liegt unverändert unter MEDIA_DIR/imports/ (storageKey).
model ImportBatch {
  id               String       @id @default(cuid())
  userId           String?
  format           String // "GEDCOM" | "JSON" | …
  fileName         String
  fileSizeBytes    Int
  fileSha256       String
  storageKey       String?      @unique
  // Kennung des Stammbaums in der Quelle (z.B. die Projekt-/Baum-ID aus dem
  // Dateikopf, sonst vom Import bestimmt). Läufe mit derselben Kennung sind
  // Stände desselben Baums — nur innerhalb davon wird abgeglichen.
  sourceTreeId     String?
  // Kopf der Datei: erzeugendes Programm (HEAD.SOUR), dessen Name/Version,
  // GEDCOM-Version, Zeichensatz.
  sourceSystem     String?
  sourceSystemName String?
  sourceVersion    String?
  gedcomVersion    String?
  charset          String?
  header           Json?
  counts           Json?
  warnings         Json?
  status           ImportStatus @default(PENDING)
  notes            String?
  createdAt        DateTime     @default(now())
  finishedAt       DateTime?

  user          User?             @relation("ImportUser", fields: [userId], references: [id], onDelete: SetNull)
  externalIds   ExternalId[]
  rawRecords    ImportRawRecord[]
  firstImported ImportLink[]      @relation("ImportLinkFirst")
  lastImported  ImportLink[]      @relation("ImportLinkLast")

  @@index([fileSha256])
  @@index([sourceTreeId, createdAt])
  @@index([createdAt])
}

// Anzeigename eines Imports. Ein „Import“ im Sinn der Oberfläche ist ein
// Quell-Baum (sourceTreeId): mehrere Läufe (ImportBatch) derselben Kennung
// sind Stände desselben Baums und teilen sich Namen, Buchstabe und Farbe
// (lib/origin.ts, lib/services/origin.ts). Eine Zeile gibt es nur, wenn ein
// Administrator den Import benannt hat — sonst gilt „Import vom <Datum>“.
// Bewusst ohne Fremdschlüssel: sourceTreeId ist nirgends Primärschlüssel.
model ImportSource {
  sourceTreeId String   @id
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Einstellung der Installation, in der App gepflegt (/admin/settings). Welche
// Schlüssel es gibt, legt allein das Verzeichnis lib/settings/registry.ts
// fest; eine Zeile gibt es nur für in der App gesetzte Werte — ohne Zeile
// gilt die zugehörige Umgebungsvariable. Nur für Werte, die KEINE Geheimnisse
// sind (Zugangsdaten gehören in die Server-Konfiguration).
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Herkunft eines importierten Datensatzes — eine Zeile je Datensatz UND
// Datensatz der Quelle (sourceTreeId + externalKey), angelegt bzw.
// fortgeschrieben von jedem Import, der ihn anlegt, aktualisiert oder mit
// einem vorhandenen Datensatz verknüpft. Manuell angelegte Datensätze haben
// keine. Mehrere Zeilen je Datensatz entstehen beim Zusammenführen
// (mergedFromId) und beim Verknüpfen mit einem zweiten Baum: Der Datensatz
// bleibt so aus jedem Quell-Baum wiedererkennbar. Bewusst kein Unique auf
// (Datensatz, Baum): Wer eine Dublette INNERHALB eines Baums zusammenführt,
// behält beide Links desselben Baums (verschiedene externalKey).
//
// Wiederholter Import: Der Import erkennt den Datensatz über externalKey
// (innerhalb derselben sourceTreeId) bzw. ExternalId wieder. importHash ist
// der Fingerabdruck der Werte, wie der letzte Import sie geschrieben hat
// (lib/import-fingerprint.ts); stimmt er mit dem Fingerabdruck des heutigen
// Stands überein, wurde der Datensatz seither in der App nicht geändert und
// darf aktualisiert werden — sonst ist es eine Entscheidung für die Vorschau.
// Fehlt ein Datensatz in einem neueren Stand der Quelle, wird nichts
// gelöscht: missingSinceBatchId hält fest, dass er dort fehlte.
model ImportLink {
  id                  String    @id @default(cuid())
  // PERSON | RELATIONSHIP | EVENT | PERSON_NAME | CITATION | SOURCE | MEDIA
  entityType          String
  personId            String?
  relationshipId      String?
  eventId             String?
  personNameId        String?
  citationId          String?
  sourceId            String?
  mediaId             String?
  sourceTreeId        String?
  // Schlüssel in der Quelle, frei vom Import gewählt, z.B. "UID:4F2A…",
  // "XREF:@I12@", "XREF:@I12@/BIRT#2".
  externalKey         String?
  firstBatchId        String?
  lastBatchId         String?
  importedAt          DateTime  @default(now())
  importHash          String
  // Änderungsstempel der Quelle, wörtlich (z.B. _UPD, CHAN.DATE).
  sourceStamp         String?
  missingSinceBatchId String?
  // mergedFromId: Der Link kam beim Zusammenführen vom weggefallenen
  // Datensatz (dessen ID, ohne Fremdschlüssel). Ohne: ursprünglicher Link des
  // Datensatzes — der GEDCOM-Export schreibt dessen Originaldaten (_UID).
  // mergedAt: Der Datensatz war an einem Zusammenführen beteiligt; ein
  // erneuter Import ohne neue Angaben in der Datei meldet ihn dann nicht als
  // „in der App geändert“, sondern still als unverändert.
  mergedFromId        String?
  mergedAt            DateTime?
  createdAt           DateTime  @default(now())

  firstBatch   ImportBatch?  @relation("ImportLinkFirst", fields: [firstBatchId], references: [id], onDelete: SetNull)
  lastBatch    ImportBatch?  @relation("ImportLinkLast", fields: [lastBatchId], references: [id], onDelete: SetNull)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personName   PersonName?   @relation(fields: [personNameId], references: [id], onDelete: Cascade)
  citation     Citation?     @relation(fields: [citationId], references: [id], onDelete: Cascade)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media        MediaAsset?   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([sourceTreeId, externalKey])
  @@index([firstBatchId])
  @@index([lastBatchId])
  @@index([personId])
  @@index([relationshipId])
  @@index([eventId])
  @@index([personNameId])
  @@index([citationId])
  @@index([sourceId])
  @@index([mediaId])
}

// Ein Paar, das ein Bearbeiter als „kein Duplikat“ markiert hat: erscheint
// nicht mehr unter „Mögliche Dubletten“, nicht als Importvorschlag und nicht
// beim Zusammenlegen von Bäumen. Kanonisch gespeichert (personAId < personBId).
model DuplicateDismissal {
  personAId String
  personBId String
  userId    String?
  createdAt DateTime @default(now())

  personA Person @relation("DismissalA", fields: [personAId], references: [id], onDelete: Cascade)
  personB Person @relation("DismissalB", fields: [personBId], references: [id], onDelete: Cascade)
  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([personAId, personBId])
  @@index([personBId])
}

// Urteil einer KI-Vorprüfung (MCP review_duplicate). Nur eine Einschätzung:
// Sie führt nichts zusammen, blendet nichts aus und ändert die Klasse
// (sicher/wahrscheinlich/unklar) eines Paares nicht.
enum DuplicateVerdict {
  MERGE
  DISPUTED
  NOT_DUPLICATE
}

// Einschätzung des KI-Assistenten zu einem möglichen Dublettenpaar — je Paar
// höchstens eine (eine neue ersetzt die alte). Kanonisch gespeichert
// (personAId < personBId). stateA/stateB halten den Stand beider Personen zum
// Zeitpunkt der Einschätzung fest (Fingerabdruck, lib/services/
// duplicate-reviews.ts); weicht der heutige Stand ab, gilt sie als „veraltet“.
// apiTokenId bewusst ohne Fremdschlüssel (wie im AuditLog): der Verweis bleibt
// auch nach dem Löschen des Schlüssels erhalten.
model DuplicateReview {
  personAId       String
  personBId       String
  verdict         DuplicateVerdict
  reason          String
  // Vorschlag, welcher Eintrag bleiben soll (eine der beiden Personen) — nur
  // Text in der Oberfläche, wählt nie etwas vor.
  suggestedKeepId String?
  userId          String?
  apiTokenId      String?
  stateA          String
  stateB          String
  reviewedAt      DateTime         @default(now())

  personA Person @relation("ReviewA", fields: [personAId], references: [id], onDelete: Cascade)
  personB Person @relation("ReviewB", fields: [personBId], references: [id], onDelete: Cascade)
  user    User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([personAId, personBId])
  @@index([personBId])
}

// Fremdkennung eines Datensatzes, damit ein erneuter Import ihn wiedererkennt:
// system z.B. "GEDCOM_XREF" (value "@I12@", nur zusammen mit batchId
// eindeutig), "UID" (_UID), "RIN", "REFN", "AFN". Gehört zu genau einem
// Datensatz (geprüft im Dienst).
model ExternalId {
  id             String   @id @default(cuid())
  system         String
  value          String
  batchId        String?
  personId       String?
  relationshipId String?
  eventId        String?
  sourceId       String?
  mediaId        String?
  createdAt      DateTime @default(now())

  batch        ImportBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  media        MediaAsset?   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([system, value])
  @@index([batchId])
  @@index([personId])
  @@index([relationshipId])
  @@index([eventId])
  @@index([sourceId])
  @@index([mediaId])
}

// Daten, die der Import nicht deuten konnte — als JSON-Teilbaum, damit nichts
// still verloren geht und eine spätere Version sie auswerten kann. Sichtbar
// wie der Träger (Person, Beziehung, Quelle); ohne Träger nur für Admins.
model ImportRawRecord {
  id             String    @id @default(cuid())
  batchId        String?
  personId       String?
  relationshipId String?
  sourceId       String?
  // Satzart bzw. Tag-Pfad: "INDI", "FAM", "SOUR", "NOTE", "INDI.BIRT.AGE", "_MYTAG" …
  recordType     String
  xref           String?
  content        Json
  // Warum nicht übernommen (für Menschen).
  reason         String?
  sizeBytes      Int
  // Gesetzt, wenn ein späterer Import für denselben Träger neue Rohdaten
  // abgelegt hat. Ältere Stände bleiben, bis ein Admin sie entfernt
  // (pruneRawRecords).
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  batch        ImportBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  person       Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([personId])
  @@index([relationshipId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

// Kanal einer Änderung. Ohne Angabe (null): Web-App bzw. Einträge aus der Zeit
// vor dem KI-Zugang.
enum AuditChannel {
  MCP
}

model AuditLog {
  id         String        @id @default(cuid())
  userId     String?
  action     String // CREATE | UPDATE | DELETE | MERGE | CONNECT
  entityType String // Person | Relationship | MediaAsset | User | Family | Source | Citation | ApiToken | Event | PersonName | ImportBatch | ImportRawRecord | Place | Setting
  entityId   String
  // UPDATE seit dem Changelog: { changes: { feld: { from, to } } } (lib/audit.ts,
  // fieldChanges); ältere Einträge enthalten meist nur die neuen Werte.
  diff       Json?
  // Kanal und Schlüssel (ApiToken.id, nie das Geheimnis). Bewusst ohne
  // Fremdschlüssel: der Verweis bleibt auch nach dem Löschen des Benutzers
  // samt seiner Schlüssel erhalten.
  channel    AuditChannel?
  apiTokenId String?
  createdAt  DateTime      @default(now())
  // Changelog: Paket, zu dem die Änderung gehört (null bei älteren Einträgen),
  // und Momentaufnahme der betroffenen Personen und Familien zum Zeitpunkt
  // der Änderung — damit Verlauf je Person und Übersicht je Familie ohne
  // Rekonstruktion auskommen, auch wenn der Datensatz später gelöscht wird.
  changeSetId String?
  personIds   String[]  @default([])
  familyIds   String[]  @default([])
  // Einträge über eine Person (entityType Person): deren Familien zum
  // Zeitpunkt des Eintrags (beim Löschen der letzte Stand). Damit lässt sich
  // das Leserecht auch prüfen, wenn es die Person nicht mehr gibt (gelöscht
  // oder aufgegangen). subjectFamiliesKnown = false: nicht erfasst (ältere
  // Einträge, andere Arten) — dann bleibt der Eintrag für Nicht-Admins
  // verborgen. Leeres subjectFamilyIds mit Known = true heißt „ohne Familie“
  // (nur Admins).
  subjectFamilyIds     String[] @default([])
  subjectFamiliesKnown Boolean  @default(false)

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  changeSet ChangeSet? @relation(fields: [changeSetId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([apiTokenId])
  @@index([changeSetId])
  @@index([personIds], type: Gin)
  @@index([familyIds], type: Gin)
}

// Changelog: Paket zusammengehöriger Änderungen. In der App bildet jede
// Anfrage (bzw. ein Import, ein Zusammenführen, ein Sammel-Zusammenführen)
// ein Paket; über den KI-Zugang öffnet begin_change_set eines mit Titel,
// sonst bündelt der Server je Schlüssel innerhalb eines Zeitfensters
// (lib/change-sets.ts). Angelegt wird ein Paket erst mit dem ersten Eintrag.
model ChangeSet {
  id             String        @id @default(cuid())
  title          String
  // APP | IMPORT | MERGE | CONNECT | MCP (über begin_change_set) | MCP_AUTO
  kind           String        @default("APP")
  userId         String?
  channel        AuditChannel?
  // Wie AuditLog.apiTokenId bewusst ohne Fremdschlüssel.
  apiTokenId     String?
  createdAt      DateTime      @default(now())
  // Letzter Eintrag — für das Bündeln über den KI-Zugang ohne Kennung.
  lastActivityAt DateTime      @default(now())

  user    User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries AuditLog[]

  @@index([createdAt])
  @@index([userId, kind, lastActivityAt])
}

// ---------------------------------------------------------------------------
// Orte (Karte „Wurzeln nach Jahr“, docs/fachlich/karte-und-orte.md)
// ---------------------------------------------------------------------------

// Woher die Koordinaten eines Ortstexts stammen.
enum PlaceSource {
  AUTO // automatisch aus dem mitgelieferten Ortsverzeichnis (geo/gazetteer.tsv.gz)
  MANUAL // von Hand bestätigt oder eingegeben — wird nie automatisch überschrieben
  AI // vom KI-Assistenten über MCP gesetzt („KI-Vorschlag“) — die Automatik überschreibt nie, ein Admin bestätigt (→ MANUAL)
}

// Wie genau die Zuordnung ist: der Ort selbst, nur die Region (Bundesland,
// historische Landschaft) oder nur das Land.
enum PlacePrecision {
  PLACE
  REGION
  COUNTRY
}

// Zuordnung eines Ortstexts (wie er an Personen, Beziehungen und Ereignissen
// steht) zu Koordinaten. Schlüssel ist der normalisierte Text
// (lib/places/normalize.ts, placeKey) — alle Schreibweisen, die sich nur in
// Groß-/Kleinschreibung und Leerzeichen unterscheiden, teilen sich eine
// Zeile. Ortstexte ohne Zeile sind „offen“. Nur Administratoren sehen und
// ändern die Tabelle (lib/services/places.ts); die Karte liest nur
// Koordinaten zu Ortstexten sichtbarer Personen.
model Place {
  id           String          @id @default(cuid())
  key          String          @unique
  // Eine Schreibweise des Texts (zuletzt zugeordnet), für die Anzeige.
  text         String
  source       PlaceSource
  // Von Hand als „nicht zuordenbar“ markiert (dann ohne Koordinaten).
  unresolvable Boolean         @default(false)
  precision    PlacePrecision?
  latitude     Float?
  longitude    Float?
  // Anzeigename der Zuordnung, z.B. „Peine, Niedersachsen, Deutschland“.
  label        String?
  countryCode  String?
  // Kennung im Ortsverzeichnis (GeoNames-ID bzw. „h…“ für historische
  // Landschaften); leer bei von Hand eingegebenen Koordinaten.
  gazetteerId  String?
  // Begründung bzw. Notiz zur Zuordnung (v.a. der KI), auf /admin/places sichtbar.
  note         String?
  // Als unsicher gesetzt (KI: „vermutlich“) — ein Mensch sollte prüfen.
  uncertain    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([source])
}
