# ---------------------------------------------------------------------------
# Variablen für den Produktivstack (docker-compose.yml) — genau diese in
# Portainer unter "Environment variables" eintragen (Schaltfläche
# "Advanced mode" erlaubt, den Block am Stück einzufügen).
#
# Nicht für die lokale Entwicklung; die nutzt .env (siehe .env.example).
# Diese Datei enthält nur Platzhalter. Echte Werte NIE einchecken.
#
# Zufallswerte erzeugen (Linux/macOS/Git Bash, oder per SSH auf der NAS):
#   openssl rand -hex 32        # Passwörter/Schlüssel (nur 0-9a-f — wichtig,
#                               # weil POSTGRES_PASSWORD in einer URL steht)
#   openssl rand -base64 32     # AUTH_SECRET
# PowerShell ohne openssl:
#   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
# ---------------------------------------------------------------------------

# --- Pflicht ---------------------------------------------------------------

# Absoluter Pfad auf der NAS für ALLE Daten (Datenbank, Bilder unter
# media/, Sicherungen). Genau diesen Ordner muss die NAS-Sicherung erfassen.
DATA_ROOT=/volume1/docker/familytree

# Datenbank-Passwort. Nur Hex-Zeichen verwenden (openssl rand -hex 32).
POSTGRES_PASSWORD=

# Schlüssel für Sitzungen (openssl rand -base64 32). Ändern meldet alle ab.
AUTH_SECRET=

# Genau die Adresse, die im Browser eingegeben wird — mit http/https, Host und
# ggf. Port, ohne abschließenden Pfad. Daraus ergeben sich die
# OAuth-Callback-URLs: <PUBLIC_URL>/api/auth/callback/github bzw. /google
PUBLIC_URL=https://stammbaum.example.de

# Erster Administrator (muss die E-Mail des GitHub-/Google-Kontos sein).
INITIAL_ADMIN_EMAIL=

# Mindestens ein Anbieter (siehe README, "Anmeldung (OAuth) im Heimnetz").
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional (Standardwerte stehen in den auskommentierten Zeilen) --------

# Port für den Reverse-Proxy der NAS und Bind-Adresse. 127.0.0.1 genügt für
# den Synology-Reverse-Proxy. Für Nginx Proxy Manager im Container: LAN-IP der
# NAS, z.B. 192.168.178.10.
#APP_PORT=3080
#APP_BIND=127.0.0.1

# Image-Version: latest, ein Commit (sha-1a2b3c4) oder ein Release (1.2.0).
#IMAGE_TAG=latest
#IMAGE_REPO=ghcr.io/soschlegel/familiy-tree

# Aufbewahrung der Datenbanksicherungen in Tagen.
#BACKUP_KEEP_DAYS=30

# Größte Bilddatei in Bytes (15728640 = 15 MB).
#MAX_UPLOAD_BYTES=15728640

#POSTGRES_USER=familytree
#POSTGRES_DB=familytree

# Zusatzdienst "caddy": eigener Reverse-Proxy, nur ohne vorhandenen Proxy.
#COMPOSE_PROFILES=caddy

# Nur mit COMPOSE_PROFILES=caddy. CADDY_SITE = Hostname (z.B.
# stammbaum.fritz.box); CADDY_TLS = internal (eigene CA) oder eine E-Mail
# (Let's Encrypt, nur bei öffentlich erreichbarem Host).
#CADDY_SITE=localhost
#CADDY_TLS=internal
#CADDY_HTTP_PORT=8080
#CADDY_HTTPS_PORT=8443
#CADDY_BIND=0.0.0.0
#CADDY_MAX_BODY=1GB

# Nur zur Fehlersuche: false startet die App ohne Migrationen und ohne
# Admin-Abgleich (README, "Fehlersuche"). Danach wieder entfernen.
#RUN_MIGRATIONS=true
