{
  "name": "familytree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs all",
    "test:e2e:setup": "node scripts/e2e.mjs setup",
    "test:e2e:read": "node scripts/e2e.mjs read",
    "test:e2e:write": "node scripts/e2e.mjs write",
    "test:e2e:headed": "node scripts/e2e.mjs all --headed --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:mock": "node scripts/mock.mjs seed",
    "mock:setup": "node scripts/mock.mjs setup",
    "dev:mock": "node scripts/mock.mjs dev",
    "mock:build": "node scripts/mock.mjs build",
    "mock:start": "node scripts/mock.mjs start",
    "mock:env": "node scripts/mock.mjs env",
    "mcp:stdio": "node scripts/mock.mjs mcp",
    "mcp:key": "node scripts/mock.mjs mcp-key",
    "gedcom:check": "tsx lib/gedcom/cli.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/client": "^6.1.0",
    "jszip": "^3.10.1",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactflow": "^11.11.4",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
