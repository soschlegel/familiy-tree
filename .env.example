# ---------------------------------------------------------------------------
# Lokale Entwicklung: Datei nach .env kopieren.
# Produktion/Portainer: dieselben Schlüssel als Stack-Umgebungsvariablen.
# ---------------------------------------------------------------------------

# --- Datenbank ---
DATABASE_URL="postgresql://familytree:familytree@localhost:5432/familytree"

# --- Auth ---
# Erzeugen mit:  npx auth secret     oder     openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Erster Administrator. Wird beim Seed/Containerstart angelegt.
INITIAL_ADMIN_EMAIL="deine@mail.de"

# Erlaubt Anmeldung per E-Mail ohne Passwort — ausschließlich lokal.
# In Produktion NICHT setzen.
ENABLE_DEV_LOGIN="true"

# OAuth. Callback-URLs beim Anbieter eintragen:
#   http://localhost:3000/api/auth/callback/github
#   https://stammbaum.example.de/api/auth/callback/github
# GitHub:  Settings -> Developer settings -> OAuth Apps
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Objektspeicher (MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="familytree"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# 15 MB
MAX_UPLOAD_BYTES="15728640"

# --- Nur für docker-compose.yml (Produktion) ---
# Ein einziger Pfad für alle persistenten Daten — genau dieses Verzeichnis
# muss die NAS-Sicherung erfassen.
#   NAS-Beispiel: DATA_ROOT=/volume1/docker/familytree
DATA_ROOT="./data"
POSTGRES_USER="familytree"
POSTGRES_PASSWORD="bitte-ersetzen"
POSTGRES_DB="familytree"
DOMAIN="localhost"
PUBLIC_URL="https://localhost"
HTTP_PORT="80"
HTTPS_PORT="443"

# Demofamilie beim Seed anlegen (nur für den ersten Blick).
SEED_DEMO="true"
