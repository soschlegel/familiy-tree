# ---------------------------------------------------------------------------
# Lokale Entwicklung: Datei nach .env kopieren.
# Produktion/Portainer: stattdessen stack.env.example verwenden.
# ---------------------------------------------------------------------------

# --- Datenbank ---
DATABASE_URL="postgresql://familytree:familytree@localhost:5432/familytree"

# --- Auth ---
# Erzeugen mit:  npx auth secret     oder     openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Erster Administrator. Wird beim Seed/Containerstart angelegt.
INITIAL_ADMIN_EMAIL="deine@mail.de"

# Erlaubt Anmeldung per E-Mail ohne Passwort — ausschließlich lokal.
# In Produktion NICHT setzen.
ENABLE_DEV_LOGIN="true"

# OAuth. Callback-URLs beim Anbieter eintragen:
#   http://localhost:3000/api/auth/callback/github
#   https://stammbaum.example.de/api/auth/callback/github
# GitHub:  Settings -> Developer settings -> OAuth Apps
# Google:  console.cloud.google.com -> APIs & Services -> Credentials
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Bilder ---
# Ordner für alle Bilddateien (absolut oder relativ zum Projektordner).
# Lokal liegt er unter ./data (per .gitignore ausgenommen); die Mock-Umgebung
# verwendet automatisch einen eigenen Ordner (./data/media-mock).
# Im Produktivstack setzt docker-compose.yml MEDIA_DIR selbst.
MEDIA_DIR="./data/media"

# 15 MB
MAX_UPLOAD_BYTES="15728640"

# --- Produktion (docker-compose.yml / Portainer) ---
# Die Variablen für den Produktivstack stehen getrennt in stack.env.example
# (in Portainer unter "Environment variables" einfügen). Diese .env ist nur
# für die lokale Entwicklung.

# Demofamilie beim Seed anlegen (nur für den ersten Blick).
SEED_DEMO="true"

# --- Mock-Umgebung (npm run mock:setup / dev:mock, Tests) ---
# Eigene Mock-Datenbank, z.B. je Git-Worktree. Ohne Angabe wird sie aus
# DATABASE_URL abgeleitet (…/familytree -> …/familytree_mock); der Name muss
# auf _mock oder _test enden.
#MOCK_DATABASE_URL="postgresql://familytree:familytree@localhost:5432/familytree_mock"
# Eigener Bilderordner der Mock-Umgebung (Name muss auf -mock/-test enden).
#MOCK_MEDIA_DIR="./data/media-mock"
# Port des Mock-Servers (Standard 3100) — NUR in der Shell setzen
# (PowerShell: $env:MOCK_PORT='3101'), nicht hier: scripts/mock.mjs liest ihn
# vor der .env, und mehrere Worktrees brauchen verschiedene Ports.

# --- KI-Zugang lokal ---
# Weitere erlaubte Origins für /api/mcp (kommagetrennt), nur für MCP-Clients
# im Browser, z.B. den MCP Inspector. Anfragen ohne Origin (Claude Code)
# brauchen das nicht; die eigene Adresse (AUTH_URL) ist immer erlaubt.
#MCP_ALLOWED_ORIGINS="http://localhost:6274"
# Lokaler MCP-Server über stdio (npm run mcp:stdio): als welcher Benutzer und
# ob Schreibwerkzeuge erlaubt sind (zusätzlich zum KI-Recht des Benutzers).
#MCP_USER_EMAIL="admin@example.test"
#MCP_ALLOW_WRITE="false"
